{
  "version": 1,
  "vendor": "gitlab",
  "providers": {"vcs-posture": "gitlab", "access-posture": "gitlab"},
  "accounts": {
    "group-owner": {"kind": "human", "enabled": true, "roles": ["Owner"], "mfa": "totp", "logins": ["saml", "password"], "signed_in_days_ago": 3},
    "maintainer": {"kind": "human", "enabled": true, "roles": ["Maintainer"], "logins": "password", "signed_in_days_ago": 200},
    "external-dev": {"kind": "external", "enabled": true, "roles": ["Developer"], "mfa": "webauthn", "logins": "password", "signed_in_days_ago": 1},
    "blocked-dev": {"kind": "human", "enabled": false, "roles": ["Developer"], "logins": "password"},
    "group_7_bot_3f2a": {"kind": "bot", "enabled": true, "roles": ["Maintainer"], "logins": "password"}
  },
  "vcs": {
    "organization": "acme-group",
    "two_factor_requirement": false,
    "allowed_sources": ["10.0.0.0/8"],
    "credentials": {
      "group-token": {"owner": "group_7_bot_3f2a", "created_days_ago": 30, "expires_in_days": 300, "last_used_days_ago": 1, "permissions": "api"},
      "platform-api-token": {"repositories": ["platform-api"], "created_days_ago": 100, "expires_in_days": 10, "permissions": "read_api"},
      "shared-key": {"repositories": ["scripts", "platform-docs"], "created_days_ago": 10, "last_used_days_ago": 95, "permissions": "can_push"},
      "scripts-key": {"repositories": ["scripts"], "created_days_ago": 400, "permissions": "can_push"},
      "revoked-token": {"active": false, "created_days_ago": 500, "permissions": "api"}
    },
    "include_patterns": ["platform-*"],
    "repositories": {
      "platform-api": {
        "protections": {
          "protected_branch": {
            "enforcement": "protected",
            "rules": {"push_access_no_one": {}, "approval_rule": {"approvals": 1}}
          },
          "merge_settings": {
            "enforcement": "protected",
            "rules": {"only_allow_merge_if_pipeline_succeeds": {"checks": ["pipeline"]}}
          },
          "push_rules": {"enforcement": "protected", "rules": {"reject_unsigned_commits": {}}}
        }
      },
      "platform-docs": {
        "protections": {
          "approval_rules": {"enforcement": "protected", "rules": {"approval_rule": {"approvals": 2}}}
        }
      },
      "scripts": {}
    }
  },
  "terms": {
    "account_kinds": {"human": "member", "external": "guest", "bot": "service"},
    "roles": {"Owner": "admin", "Maintainer": "none", "Developer": "none"},
    "mfa_methods": {"totp": "mfa", "webauthn": "phishing_resistant"},
    "login_methods": {"saml": "sso", "password": "local"},
    "network_sources": {"10.0.0.0/8": "limited"},
    "vcs_credential_permissions": {"api": "full", "read_api": "read", "can_push": "write"},
    "vcs_enforcements": {"protected": "enforced"},
    "vcs_rules": {
      "push_access_no_one": "pull_request",
      "approval_rule": "approvals",
      "only_allow_merge_if_pipeline_succeeds": "status_checks",
      "reject_unsigned_commits": "signed_commits"
    }
  }
}
