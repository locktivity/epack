{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "evidencepack/tls@v1",
  "title": "TLS posture",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "collected_at", "endpoints"],
  "properties": {
    "schema_version": {
      "description": "Version of this schema, always 1.0.0.",
      "type": "string",
      "const": "1.0.0",
      "x-epack-label": "Schema version"
    },
    "collected_at": {
      "description": "When the collector checked the endpoints, as an ISO 8601 timestamp.",
      "type": "string",
      "format": "date-time",
      "x-epack-label": "Collected at"
    },
    "endpoints": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/endpoint_result"
      },
      "x-epack-label": "Endpoints",
      "x-epack-summary": "TLS posture for each configured endpoint."
    },
    "summary": {
      "$ref": "#/$defs/summary",
      "x-epack-label": "Summary",
      "x-epack-summary": "TLS posture across all configured endpoints."
    },
    "diagnostics": {
      "$ref": "#/$defs/diagnostics",
      "x-epack-label": "Diagnostics",
      "x-epack-summary": "Errors and warnings raised during collection."
    }
  },
  "$defs": {
    "endpoint_result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["host", "port"],
      "properties": {
        "host": {
          "description": "The hostname the collector connected to.",
          "type": "string",
          "x-epack-label": "Host"
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535,
          "x-epack-label": "Port",
          "x-epack-summary": "TCP port of the endpoint."
        },
        "reachable": {
          "type": ["boolean", "null"],
          "x-epack-label": "Reachable over TLS",
          "x-epack-summary": "Whether a TLS 1.2 or TLS 1.3 handshake with the endpoint succeeded."
        },
        "tls": {
          "$ref": "#/$defs/tls_details",
          "x-epack-label": "TLS protocol",
          "x-epack-summary": "The negotiated TLS version and cipher suite, and the TLS versions the endpoint supports."
        },
        "certificate": {
          "$ref": "#/$defs/certificate",
          "x-epack-label": "Certificate",
          "x-epack-summary": "The leaf certificate presented by the endpoint."
        },
        "assessment": {
          "$ref": "#/$defs/assessment",
          "x-epack-label": "Assessment",
          "x-epack-summary": "TLS assessment for the endpoint."
        },
        "errors": {
          "description": "Problems the collector hit while connecting to this endpoint.",
          "type": "array",
          "items": {
            "type": "string"
          },
          "x-epack-label": "Errors"
        }
      }
    },
    "tls_details": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "negotiated_version": {
          "description": "The TLS version the endpoint chose when the collector connected, such as TLS 1.3.",
          "type": "string",
          "x-epack-label": "Negotiated TLS version"
        },
        "negotiated_cipher_suite": {
          "description": "The cipher suite the endpoint chose for that connection.",
          "type": "string",
          "x-epack-label": "Negotiated cipher suite"
        },
        "protocol_support": {
          "$ref": "#/$defs/protocol_support",
          "x-epack-label": "Supported TLS versions",
          "x-epack-summary": "Which TLS versions the endpoint supports."
        }
      }
    },
    "protocol_support": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "tls_1_0": {
          "type": ["boolean", "null"],
          "x-epack-label": "TLS 1.0 support",
          "x-epack-summary": "Whether the endpoint supports TLS 1.0.",
          "x-epack-goal": false
        },
        "tls_1_1": {
          "type": ["boolean", "null"],
          "x-epack-label": "TLS 1.1 support",
          "x-epack-summary": "Whether the endpoint supports TLS 1.1.",
          "x-epack-goal": false
        },
        "tls_1_2": {
          "type": ["boolean", "null"],
          "x-epack-label": "TLS 1.2 support",
          "x-epack-summary": "Whether the endpoint supports TLS 1.2."
        },
        "tls_1_3": {
          "type": ["boolean", "null"],
          "x-epack-label": "TLS 1.3 support",
          "x-epack-summary": "Whether the endpoint supports TLS 1.3."
        }
      }
    },
    "certificate": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["not_before", "not_after", "fingerprint_sha256"],
      "properties": {
        "subject_common_name": {
          "description": "The common name in the certificate's subject.",
          "type": "string",
          "x-epack-label": "Subject common name"
        },
        "issuer_common_name": {
          "description": "The common name of the certificate authority that issued the certificate.",
          "type": "string",
          "x-epack-label": "Issuer common name"
        },
        "serial_number": {
          "description": "The certificate's serial number, as its issuer assigned it.",
          "type": "string",
          "x-epack-label": "Serial number"
        },
        "not_before": {
          "description": "The start of the certificate's validity period.",
          "type": "string",
          "format": "date-time",
          "x-epack-label": "Valid from"
        },
        "not_after": {
          "description": "The end of the certificate's validity period. expires_in_days counts down to it.",
          "type": "string",
          "format": "date-time",
          "x-epack-label": "Valid until"
        },
        "expires_in_days": {
          "type": ["integer", "null"],
          "x-epack-label": "Days until expiry",
          "x-epack-summary": "Whole days until the certificate expires. A negative value means it has expired."
        },
        "dns_names": {
          "description": "The hostnames the certificate is valid for, from its subject alternative names.",
          "type": "array",
          "items": {
            "type": "string"
          },
          "x-epack-label": "DNS names"
        },
        "ip_addresses": {
          "description": "The IP addresses the certificate is valid for, from its subject alternative names.",
          "type": "array",
          "items": {
            "type": "string"
          },
          "x-epack-label": "IP addresses"
        },
        "fingerprint_sha256": {
          "description": "The SHA-256 hash of the certificate, which identifies it exactly.",
          "type": "string",
          "pattern": "^[A-F0-9]{64}$",
          "x-epack-label": "SHA-256 fingerprint"
        },
        "signature_algorithm": {
          "description": "The algorithm the issuer used to sign the certificate.",
          "type": "string",
          "x-epack-label": "Signature algorithm"
        },
        "public_key_algorithm": {
          "description": "The algorithm of the certificate's public key, such as RSA or ECDSA.",
          "type": "string",
          "x-epack-label": "Public key algorithm"
        },
        "chain_length": {
          "type": ["integer", "null"],
          "minimum": 1,
          "x-epack-label": "Chain length",
          "x-epack-summary": "Certificates presented in the chain, including the leaf."
        },
        "trusted_chain": {
          "type": ["boolean", "null"],
          "x-epack-label": "Trusted chain",
          "x-epack-summary": "Whether the certificate chains to a trusted root.",
          "x-epack-goal": true
        },
        "hostname_valid": {
          "type": ["boolean", "null"],
          "x-epack-label": "Hostname valid",
          "x-epack-summary": "Whether the certificate matches the endpoint's hostname.",
          "x-epack-goal": true
        }
      }
    },
    "assessment": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "certificate_valid": {
          "type": ["boolean", "null"],
          "x-epack-label": "Certificate valid",
          "x-epack-summary": "Whether the certificate is trusted and matches the endpoint's hostname. It must also be within its validity period.",
          "x-epack-goal": true
        },
        "hostname_valid": {
          "type": ["boolean", "null"],
          "x-epack-label": "Hostname valid",
          "x-epack-summary": "Whether the certificate matches the endpoint's hostname.",
          "x-epack-goal": true
        },
        "expired": {
          "type": ["boolean", "null"],
          "x-epack-label": "Certificate expired",
          "x-epack-summary": "Whether the certificate has expired.",
          "x-epack-goal": false
        },
        "expiring_soon": {
          "type": ["boolean", "null"],
          "x-epack-label": "Expiring soon",
          "x-epack-summary": "Whether the certificate has not yet expired and expires within 30 days.",
          "x-epack-goal": false
        },
        "modern_protocol": {
          "type": ["boolean", "null"],
          "x-epack-label": "Modern TLS supported",
          "x-epack-summary": "Whether the endpoint supports TLS 1.2 or TLS 1.3.",
          "x-epack-goal": true
        },
        "legacy_protocol_supported": {
          "type": ["boolean", "null"],
          "x-epack-label": "Legacy TLS supported",
          "x-epack-summary": "Whether the endpoint supports TLS 1.0 or TLS 1.1.",
          "x-epack-goal": false
        },
        "issues": {
          "description": "A short description of each problem the assessment found, such as an expired certificate. Empty when there are none.",
          "type": "array",
          "items": {
            "type": "string"
          },
          "x-epack-label": "Issues"
        }
      }
    },
    "summary": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "total_endpoints": {
          "type": ["integer", "null"],
          "minimum": 0,
          "x-epack-label": "Total endpoints",
          "x-epack-summary": "Endpoints included in the scan."
        },
        "reachable_count": {
          "type": ["integer", "null"],
          "minimum": 0,
          "x-epack-label": "Reachable endpoints",
          "x-epack-summary": "Endpoints where a TLS 1.2 or TLS 1.3 handshake succeeded."
        },
        "reachable_pct": {
          "type": ["integer", "null"],
          "minimum": 0,
          "maximum": 100,
          "x-epack-numerator": "reachable_count",
          "x-epack-denominator": "total_endpoints",
          "x-epack-rounding": "floor",
          "x-epack-label": "Reachability",
          "x-epack-summary": "Share of endpoints where a TLS 1.2 or TLS 1.3 handshake succeeded."
        },
        "certificate_valid_count": {
          "type": ["integer", "null"],
          "minimum": 0,
          "x-epack-label": "Endpoints with valid certificates",
          "x-epack-summary": "Endpoints whose certificate is trusted and matches their hostname. The certificate must also be within its validity period."
        },
        "certificate_valid_pct": {
          "type": ["integer", "null"],
          "minimum": 0,
          "maximum": 100,
          "x-epack-numerator": "certificate_valid_count",
          "x-epack-denominator": "total_endpoints",
          "x-epack-rounding": "floor",
          "x-epack-label": "Valid certificates",
          "x-epack-summary": "Share of endpoints whose certificate is trusted and matches their hostname. The certificate must also be within its validity period."
        },
        "hostname_valid_count": {
          "type": ["integer", "null"],
          "minimum": 0,
          "x-epack-label": "Endpoints matching their hostname",
          "x-epack-summary": "Endpoints whose certificate matches their hostname."
        },
        "hostname_valid_pct": {
          "type": ["integer", "null"],
          "minimum": 0,
          "maximum": 100,
          "x-epack-numerator": "hostname_valid_count",
          "x-epack-denominator": "total_endpoints",
          "x-epack-rounding": "floor",
          "x-epack-label": "Hostname matches",
          "x-epack-summary": "Share of endpoints whose certificate matches their hostname."
        },
        "modern_protocol_count": {
          "type": ["integer", "null"],
          "minimum": 0,
          "x-epack-label": "Endpoints with modern TLS",
          "x-epack-summary": "Endpoints that support TLS 1.2 or TLS 1.3."
        },
        "modern_protocol_pct": {
          "type": ["integer", "null"],
          "minimum": 0,
          "maximum": 100,
          "x-epack-numerator": "modern_protocol_count",
          "x-epack-denominator": "total_endpoints",
          "x-epack-rounding": "floor",
          "x-epack-label": "Modern TLS",
          "x-epack-summary": "Share of endpoints that support TLS 1.2 or TLS 1.3."
        },
        "expiring_soon_count": {
          "type": ["integer", "null"],
          "minimum": 0,
          "x-epack-label": "Certificates expiring soon",
          "x-epack-summary": "Endpoints whose certificate has not yet expired and expires within 30 days.",
          "x-epack-goal": "lower"
        },
        "expiring_soon_pct": {
          "type": ["integer", "null"],
          "minimum": 0,
          "maximum": 100,
          "x-epack-numerator": "expiring_soon_count",
          "x-epack-denominator": "total_endpoints",
          "x-epack-rounding": "ceil",
          "x-epack-label": "Expiring soon",
          "x-epack-summary": "Share of endpoints whose certificate has not yet expired and expires within 30 days."
        },
        "legacy_protocol_supported_count": {
          "type": ["integer", "null"],
          "minimum": 0,
          "x-epack-label": "Endpoints supporting legacy TLS",
          "x-epack-summary": "Endpoints that support TLS 1.0 or TLS 1.1.",
          "x-epack-goal": "lower"
        },
        "legacy_protocol_supported_pct": {
          "type": ["integer", "null"],
          "minimum": 0,
          "maximum": 100,
          "x-epack-numerator": "legacy_protocol_supported_count",
          "x-epack-denominator": "total_endpoints",
          "x-epack-rounding": "ceil",
          "x-epack-label": "Legacy TLS",
          "x-epack-summary": "Share of endpoints that support TLS 1.0 or TLS 1.1."
        },
        "all_certificates_valid": {
          "type": ["boolean", "null"],
          "x-epack-numerator": "certificate_valid_count",
          "x-epack-denominator": "total_endpoints",
          "x-epack-label": "All certificates valid",
          "x-epack-summary": "Whether every endpoint has a valid certificate.",
          "x-epack-goal": true
        },
        "all_modern_protocol": {
          "type": ["boolean", "null"],
          "x-epack-numerator": "modern_protocol_count",
          "x-epack-denominator": "total_endpoints",
          "x-epack-label": "Modern TLS on all endpoints",
          "x-epack-summary": "Whether every endpoint supports TLS 1.2 or TLS 1.3.",
          "x-epack-goal": true
        }
      }
    },
    "diagnostics": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "endpoint_errors": {
          "description": "Connection problems across all endpoints, one entry for each problem.",
          "type": "array",
          "items": {
            "type": "string"
          },
          "x-epack-label": "Endpoint errors"
        },
        "warnings": {
          "description": "Warnings raised during collection that did not stop it.",
          "type": "array",
          "items": {
            "type": "string"
          },
          "x-epack-label": "Warnings"
        }
      }
    }
  }
}
