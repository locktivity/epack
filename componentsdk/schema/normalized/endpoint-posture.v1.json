{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Normalized device management and endpoint security evidence. Every metric is optional. An absent metric has no usable reading, and availability records why. Below the audit level, counts that grow with the fleet are left out, and devices_present is written instead.",
  "type": "object",
  "required": ["schema_version", "collected_at", "provider", "scope", "availability"],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^1\\.\\d+\\.\\d+$",
      "x-epack-label": "Schema version"
    },
    "collected_at": {
      "$ref": "#/$defs/timestamp",
      "x-epack-label": "Collected at"
    },
    "provider": {
      "type": "string",
      "minLength": 1,
      "x-epack-label": "Provider"
    },
    "organization_id": {
      "type": "string",
      "x-epack-level": "audit",
      "description": "The provider's organization identifier",
      "x-epack-label": "Organization"
    },
    "scope": {
      "type": "object",
      "required": ["discovery_complete", "description", "max_observation_age_seconds"],
      "properties": {
        "discovery_complete": {
          "type": ["boolean", "null"],
          "description": "Whether every device the provider lists was read. When false or null, fleet totals and percentages are left out. Null when the collector could not tell",
          "x-epack-label": "All devices collected",
          "x-epack-summary": "Whether data was collected from every device listed in the provider."
        },
        "observed_device_count": {
          "$ref": "#/$defs/count",
          "x-epack-level": "audit",
          "description": "Devices observed within max_observation_age_seconds",
          "x-epack-label": "Devices observed",
          "x-epack-summary": "Devices that reported within the maximum reading age."
        },
        "description": {
          "type": "string",
          "pattern": "^[a-z0-9_]+$",
          "description": "A fixed name for the scope, such as managed_devices",
          "x-epack-label": "Scope name"
        },
        "max_observation_age_seconds": {
          "type": "integer",
          "minimum": 1,
          "description": "How recently a device must have reported to count",
          "x-epack-label": "Maximum reading age (seconds)",
          "x-epack-summary": "How recently, in seconds, a device must have reported for its reading to count."
        }
      },
      "additionalProperties": false,
      "x-epack-label": "Scope",
      "x-epack-summary": "Which devices these readings cover and how current they must be."
    },
    "fleet": {
      "type": "object",
      "properties": {
        "devices_present": {
          "type": ["boolean", "null"],
          "description": "Whether the fleet has any devices in scope. When false, the percentages have no devices to count",
          "x-epack-label": "Devices present",
          "x-epack-summary": "Whether the fleet has any devices in scope."
        },
        "device_count": {
          "$ref": "#/$defs/count",
          "x-epack-level": "audit",
          "description": "Devices in scope",
          "x-epack-label": "Devices in scope",
          "x-epack-summary": "Devices in scope."
        },
        "managed_device_count": {
          "$ref": "#/$defs/count",
          "x-epack-level": "audit",
          "description": "Devices in scope that the provider manages",
          "x-epack-label": "Managed devices",
          "x-epack-summary": "Devices in scope that are managed through the provider."
        },
        "mdm_enrolled_device_count": {
          "$ref": "#/$defs/count",
          "x-epack-level": "audit",
          "description": "Devices in scope with affirmative evidence of MDM enrollment",
          "x-epack-label": "MDM-enrolled devices",
          "x-epack-summary": "Devices in scope that are confirmed enrolled in MDM."
        },
        "mdm_enrolled_pct": {
          "$ref": "#/$defs/pct",
          "x-epack-numerator": "mdm_enrolled_device_count",
          "x-epack-denominator": "device_count",
          "x-epack-present": "devices_present",
          "x-epack-rounding": "floor",
          "description": "Percentage of devices in scope with affirmative evidence of MDM enrollment. Null when there are no devices",
          "x-epack-label": "MDM enrollment",
          "x-epack-summary": "Share of devices in scope that are confirmed enrolled in MDM."
        },
        "devices_by_os": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/os_family"
          },
          "additionalProperties": {
            "$ref": "#/$defs/count",
            "x-epack-label": "Devices in this OS family",
            "x-epack-summary": "Devices in scope with this OS family."
          },
          "x-epack-level": "audit",
          "description": "Devices in scope by operating system family",
          "x-epack-label": "Devices by OS",
          "x-epack-summary": "Devices in scope by OS family."
        }
      },
      "additionalProperties": false,
      "x-epack-label": "Fleet",
      "x-epack-summary": "Totals for the devices in scope."
    },
    "compliance": {
      "type": "object",
      "properties": {
        "compliant_pct": {
          "$ref": "#/$defs/pct",
          "x-epack-present": "/fleet/devices_present",
          "x-epack-rounding": "floor",
          "description": "Percentage of devices where the provider's or a baseline's compliance verdict passes, out of the devices whose reading passed or failed. Devices that are unknown or not applicable are left out. At the audit level, metric_coverage[\"compliance.compliant_pct\"] counts the devices by outcome",
          "x-epack-label": "Compliant devices",
          "x-epack-summary": "Share of evaluated devices that pass the provider's compliance check or a named baseline."
        },
        "basis": {
          "enum": ["provider_reported", "baseline_evaluation"],
          "x-epack-label": "Compliance basis"
        },
        "baseline_id": {
          "type": "string",
          "x-epack-label": "Compliance baseline"
        },
        "baseline_version": {
          "type": "string",
          "x-epack-label": "Compliance baseline version"
        }
      },
      "dependentRequired": {
        "compliant_pct": ["basis"]
      },
      "additionalProperties": false,
      "x-epack-label": "Compliance",
      "x-epack-summary": "Device compliance with the provider's policy or a named baseline."
    },
    "hardening": {
      "type": "object",
      "properties": {
        "disk_encryption_pct": {
          "$ref": "#/$defs/pct",
          "x-epack-present": "/fleet/devices_present",
          "x-epack-rounding": "floor",
          "description": "Percentage of devices where every volume is encrypted at rest, out of the devices whose reading passed or failed. Devices that are unknown or not applicable are left out. At the audit level, metric_coverage[\"hardening.disk_encryption_pct\"] counts the devices by outcome",
          "x-epack-label": "Disk encryption",
          "x-epack-summary": "Share of evaluated devices with every volume encrypted at rest."
        },
        "screen_lock_compliant_pct": {
          "$ref": "#/$defs/pct",
          "x-epack-present": "/fleet/devices_present",
          "x-epack-rounding": "floor",
          "description": "Percentage of devices where the screen lock setting meets policy, out of the devices whose reading passed or failed. Devices that are unknown or not applicable are left out. At the audit level, metric_coverage[\"hardening.screen_lock_compliant_pct\"] counts the devices by outcome",
          "x-epack-label": "Screen lock",
          "x-epack-summary": "Share of evaluated devices whose screen lock setting meets policy."
        },
        "firewall_enabled_pct": {
          "$ref": "#/$defs/pct",
          "x-epack-present": "/fleet/devices_present",
          "x-epack-rounding": "floor",
          "description": "Percentage of devices where the host firewall is on, out of the devices whose reading passed or failed. Devices that are unknown or not applicable are left out. At the audit level, metric_coverage[\"hardening.firewall_enabled_pct\"] counts the devices by outcome",
          "x-epack-label": "Firewall enabled",
          "x-epack-summary": "Share of evaluated devices with the host firewall turned on."
        }
      },
      "additionalProperties": false,
      "x-epack-label": "Hardening",
      "x-epack-summary": "Device security settings."
    },
    "patching": {
      "type": "object",
      "properties": {
        "os_supported_pct": {
          "$ref": "#/$defs/pct",
          "x-epack-present": "/fleet/devices_present",
          "x-epack-rounding": "floor",
          "description": "Percentage of devices where the operating system version still gets security updates, out of the devices whose reading passed or failed. Devices that are unknown or not applicable are left out. At the audit level, metric_coverage[\"patching.os_supported_pct\"] counts the devices by outcome",
          "x-epack-label": "Supported OS",
          "x-epack-summary": "Share of evaluated devices running an OS version that still gets security updates."
        },
        "os_baseline_compliant_pct": {
          "$ref": "#/$defs/pct",
          "x-epack-present": "/fleet/devices_present",
          "x-epack-rounding": "floor",
          "description": "Percentage of devices where the operating system meets the named baseline, out of the devices whose reading passed or failed. Devices that are unknown or not applicable are left out. At the audit level, metric_coverage[\"patching.os_baseline_compliant_pct\"] counts the devices by outcome",
          "x-epack-label": "OS baseline met",
          "x-epack-summary": "Share of evaluated devices whose OS meets the named baseline."
        },
        "unsupported_os_count": {
          "$ref": "#/$defs/count",
          "x-epack-level": "audit",
          "description": "Devices whose operating system version no longer gets security updates",
          "x-epack-label": "Unsupported OS",
          "x-epack-summary": "Devices whose OS version no longer gets security updates.",
          "x-epack-goal": "lower"
        },
        "baseline_id": {
          "type": "string",
          "x-epack-label": "OS baseline"
        },
        "baseline_version": {
          "type": "string",
          "x-epack-label": "OS baseline version"
        }
      },
      "dependentRequired": {
        "os_baseline_compliant_pct": ["baseline_id"]
      },
      "additionalProperties": false,
      "x-epack-label": "Patching",
      "x-epack-summary": "OS support and patch level."
    },
    "protection": {
      "type": "object",
      "properties": {
        "antimalware_installed_pct": {
          "$ref": "#/$defs/pct",
          "x-epack-present": "/fleet/devices_present",
          "x-epack-rounding": "floor",
          "description": "Percentage of devices where anti-malware is installed, out of the devices whose reading passed or failed. Devices that are unknown or not applicable are left out. At the audit level, metric_coverage[\"protection.antimalware_installed_pct\"] counts the devices by outcome",
          "x-epack-label": "Antimalware installed",
          "x-epack-summary": "Share of evaluated devices with antimalware installed."
        },
        "antimalware_healthy_pct": {
          "$ref": "#/$defs/pct",
          "x-epack-present": "/fleet/devices_present",
          "x-epack-rounding": "floor",
          "description": "Percentage of devices where anti-malware is installed, running, and current, out of the devices whose reading passed or failed. Devices that are unknown or not applicable are left out. At the audit level, metric_coverage[\"protection.antimalware_healthy_pct\"] counts the devices by outcome",
          "x-epack-label": "Antimalware healthy",
          "x-epack-summary": "Share of evaluated devices where antimalware is running and up to date."
        },
        "edr_installed_pct": {
          "$ref": "#/$defs/pct",
          "x-epack-present": "/fleet/devices_present",
          "x-epack-rounding": "floor",
          "description": "Percentage of devices where an EDR agent is installed, out of the devices whose reading passed or failed. Devices that are unknown or not applicable are left out. At the audit level, metric_coverage[\"protection.edr_installed_pct\"] counts the devices by outcome",
          "x-epack-label": "EDR installed",
          "x-epack-summary": "Share of evaluated devices with an EDR agent installed."
        },
        "edr_healthy_pct": {
          "$ref": "#/$defs/pct",
          "x-epack-present": "/fleet/devices_present",
          "x-epack-rounding": "floor",
          "description": "Percentage of devices where an EDR agent is installed, running, and reporting, out of the devices whose reading passed or failed. Devices that are unknown or not applicable are left out. At the audit level, metric_coverage[\"protection.edr_healthy_pct\"] counts the devices by outcome",
          "x-epack-label": "EDR healthy",
          "x-epack-summary": "Share of evaluated devices where an EDR agent is running and reporting."
        }
      },
      "additionalProperties": false,
      "x-epack-label": "Threat protection",
      "x-epack-summary": "Antimalware and endpoint detection and response (EDR) coverage."
    },
    "metric_coverage": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/metric_path"
      },
      "additionalProperties": {
        "$ref": "#/$defs/coverage",
        "x-epack-label": "Device counts for this percentage"
      },
      "x-epack-level": "audit",
      "description": "Counts of devices for each percentage, by whether the device passed, failed, could not be read, or does not apply",
      "x-epack-label": "Reading coverage",
      "x-epack-summary": "Device counts behind each percentage, by outcome."
    },
    "availability": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "reason"],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "x-epack-label": "Metric"
          },
          "reason": {
            "enum": ["unsupported", "not_read", "permission_denied", "not_configured", "stale", "partial", "source_error"],
            "x-epack-label": "Reason",
            "description": "unsupported when the vendor never reports the metric, and not_read when the vendor reports it but the collector does not read it"
          },
          "message": {
            "type": "string",
            "maxLength": 200,
            "x-epack-label": "Details"
          }
        },
        "additionalProperties": false
      },
      "description": "Why a metric has no reading, by path",
      "x-epack-label": "Unavailable readings",
      "x-epack-summary": "Metrics that have no reading, with the reason for each."
    },
    "devices": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/device"
      },
      "x-epack-level": "audit",
      "x-epack-label": "Devices",
      "x-epack-summary": "Readings for each device."
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "scope": {
            "properties": {
              "discovery_complete": {
                "const": false
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "metric_coverage": {
            "maxProperties": 0
          }
        },
        "not": {
          "anyOf": [
            {
              "required": ["fleet"]
            },
            {
              "required": ["hardening"]
            },
            {
              "required": ["protection"]
            },
            {
              "required": ["patching"]
            },
            {
              "required": ["compliance"]
            }
          ]
        }
      }
    },
    {
      "if": {
        "required": ["compliance", "metric_coverage"],
        "properties": {
          "compliance": {
            "required": ["compliant_pct"]
          }
        }
      },
      "then": {
        "properties": {
          "metric_coverage": {
            "required": ["compliance.compliant_pct"]
          }
        }
      }
    },
    {
      "if": {
        "required": ["hardening", "metric_coverage"],
        "properties": {
          "hardening": {
            "required": ["disk_encryption_pct"]
          }
        }
      },
      "then": {
        "properties": {
          "metric_coverage": {
            "required": ["hardening.disk_encryption_pct"]
          }
        }
      }
    },
    {
      "if": {
        "required": ["hardening", "metric_coverage"],
        "properties": {
          "hardening": {
            "required": ["screen_lock_compliant_pct"]
          }
        }
      },
      "then": {
        "properties": {
          "metric_coverage": {
            "required": ["hardening.screen_lock_compliant_pct"]
          }
        }
      }
    },
    {
      "if": {
        "required": ["hardening", "metric_coverage"],
        "properties": {
          "hardening": {
            "required": ["firewall_enabled_pct"]
          }
        }
      },
      "then": {
        "properties": {
          "metric_coverage": {
            "required": ["hardening.firewall_enabled_pct"]
          }
        }
      }
    },
    {
      "if": {
        "required": ["patching", "metric_coverage"],
        "properties": {
          "patching": {
            "required": ["os_supported_pct"]
          }
        }
      },
      "then": {
        "properties": {
          "metric_coverage": {
            "required": ["patching.os_supported_pct"]
          }
        }
      }
    },
    {
      "if": {
        "required": ["patching", "metric_coverage"],
        "properties": {
          "patching": {
            "required": ["os_baseline_compliant_pct"]
          }
        }
      },
      "then": {
        "properties": {
          "metric_coverage": {
            "required": ["patching.os_baseline_compliant_pct"]
          }
        }
      }
    },
    {
      "if": {
        "required": ["protection", "metric_coverage"],
        "properties": {
          "protection": {
            "required": ["antimalware_installed_pct"]
          }
        }
      },
      "then": {
        "properties": {
          "metric_coverage": {
            "required": ["protection.antimalware_installed_pct"]
          }
        }
      }
    },
    {
      "if": {
        "required": ["protection", "metric_coverage"],
        "properties": {
          "protection": {
            "required": ["antimalware_healthy_pct"]
          }
        }
      },
      "then": {
        "properties": {
          "metric_coverage": {
            "required": ["protection.antimalware_healthy_pct"]
          }
        }
      }
    },
    {
      "if": {
        "required": ["protection", "metric_coverage"],
        "properties": {
          "protection": {
            "required": ["edr_installed_pct"]
          }
        }
      },
      "then": {
        "properties": {
          "metric_coverage": {
            "required": ["protection.edr_installed_pct"]
          }
        }
      }
    },
    {
      "if": {
        "required": ["protection", "metric_coverage"],
        "properties": {
          "protection": {
            "required": ["edr_healthy_pct"]
          }
        }
      },
      "then": {
        "properties": {
          "metric_coverage": {
            "required": ["protection.edr_healthy_pct"]
          }
        }
      }
    }
  ],
  "additionalProperties": false,
  "$defs": {
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "count": {
      "type": ["integer", "null"],
      "minimum": 0
    },
    "pct": {
      "type": ["number", "null"],
      "minimum": 0,
      "maximum": 100
    },
    "os_family": {
      "enum": ["windows", "macos", "linux", "ios", "ipados", "android", "chromeos", "other", "unknown"]
    },
    "metric_path": {
      "enum": ["compliance.compliant_pct", "hardening.disk_encryption_pct", "hardening.screen_lock_compliant_pct", "hardening.firewall_enabled_pct", "patching.os_supported_pct", "patching.os_baseline_compliant_pct", "protection.antimalware_installed_pct", "protection.antimalware_healthy_pct", "protection.edr_installed_pct", "protection.edr_healthy_pct"]
    },
    "coverage": {
      "type": "object",
      "required": ["passing_device_count", "failing_device_count", "unknown_device_count", "not_applicable_device_count"],
      "properties": {
        "passing_device_count": {
          "$ref": "#/$defs/count",
          "x-epack-label": "Passing devices",
          "x-epack-summary": "Devices whose reading passed for this percentage."
        },
        "failing_device_count": {
          "$ref": "#/$defs/count",
          "x-epack-label": "Failing devices",
          "x-epack-summary": "Devices whose reading failed for this percentage.",
          "x-epack-goal": "lower"
        },
        "unknown_device_count": {
          "$ref": "#/$defs/count",
          "x-epack-label": "Devices with no reading",
          "x-epack-summary": "Devices that could not be read for this percentage."
        },
        "not_applicable_device_count": {
          "$ref": "#/$defs/count",
          "x-epack-label": "Devices not applicable",
          "x-epack-summary": "Devices that this percentage does not apply to."
        }
      },
      "additionalProperties": false
    },
    "control_key": {
      "enum": ["disk_encryption", "screen_lock", "firewall", "os_supported", "os_baseline", "compliance", "antimalware_installed", "antimalware_healthy", "edr_installed", "edr_healthy"]
    },
    "control": {
      "type": "object",
      "required": ["state"],
      "properties": {
        "state": {
          "enum": ["pass", "fail", "unknown", "not_applicable"],
          "x-epack-label": "Result"
        },
        "observed_at": {
          "$ref": "#/$defs/timestamp",
          "x-epack-label": "Observed at"
        }
      },
      "additionalProperties": false
    },
    "device": {
      "type": "object",
      "required": ["device_id", "os_family", "in_scope"],
      "properties": {
        "device_id": {
          "type": "string",
          "minLength": 1,
          "x-epack-label": "Device ID"
        },
        "hostname": {
          "type": "string",
          "x-epack-label": "Hostname"
        },
        "os_family": {
          "$ref": "#/$defs/os_family",
          "x-epack-label": "OS family"
        },
        "os_name": {
          "type": "string",
          "x-epack-label": "OS name"
        },
        "os_version": {
          "type": "string",
          "x-epack-label": "OS version"
        },
        "assigned_user": {
          "type": "object",
          "required": ["user_id"],
          "properties": {
            "user_id": {
              "type": "string",
              "x-epack-label": "Primary user ID"
            },
            "login": {
              "type": "string",
              "x-epack-label": "Primary user login"
            }
          },
          "additionalProperties": false,
          "x-epack-label": "Primary user"
        },
        "management_state": {
          "enum": ["managed", "unmanaged", "retired", "unknown"],
          "x-epack-label": "Management state"
        },
        "in_scope": {
          "type": "boolean",
          "x-epack-label": "In scope",
          "x-epack-summary": "Whether the device counts toward the fleet readings."
        },
        "created_at": {
          "$ref": "#/$defs/timestamp",
          "x-epack-label": "Record created"
        },
        "last_seen_at": {
          "$ref": "#/$defs/timestamp",
          "x-epack-label": "Last seen"
        },
        "controls": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/control_key"
          },
          "additionalProperties": {
            "$ref": "#/$defs/control",
            "x-epack-label": "Control reading"
          },
          "x-epack-label": "Controls",
          "x-epack-summary": "This device's reading for each control."
        },
        "local_admin_accounts": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "account_id": {
                "type": "string",
                "x-epack-label": "Account ID"
              },
              "username": {
                "type": "string",
                "x-epack-label": "Username"
              }
            },
            "additionalProperties": false
          },
          "x-epack-level": "internal",
          "x-epack-label": "Local admin accounts",
          "x-epack-summary": "Accounts on the device with local admin rights."
        },
        "findings": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["control", "status"],
            "properties": {
              "finding_id": {
                "type": "string",
                "x-epack-label": "Finding ID"
              },
              "control": {
                "$ref": "#/$defs/control_key",
                "x-epack-label": "Control"
              },
              "status": {
                "enum": ["open", "resolved", "unknown"],
                "x-epack-label": "Finding status"
              },
              "first_seen_at": {
                "$ref": "#/$defs/timestamp",
                "x-epack-label": "First seen"
              },
              "last_seen_at": {
                "$ref": "#/$defs/timestamp",
