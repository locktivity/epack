//go:build record

package collector

import (
	"os"
	"testing"

	"github.com/locktivity/epack/componentsdk/collectortest"
)

// TestRecord records a sandbox, an organization kept with known settings, to
// testdata/recordings/{{.Name}}.json for the collectortest suite. It reads
// the organization from {{.SandboxEnv}} and the token from
// {{.TokenEnv}}, and skips when either is not set. The recording names the
// organization by the kit's fake, and recordScrubPatterns replace the names
// of the organization and its users. The value of any other SANDBOX_
// variable becomes a stable fake, and Record writes nothing if one remains:
//
//	{{.SandboxEnv}}=... {{.TokenEnv}}=... make record
func TestRecord(t *testing.T) {
	t.Run("{{.Name}}", func(t *testing.T) {
		organization, token := os.Getenv("{{.SandboxEnv}}"), os.Getenv(tokenEnv)
		if organization == "" || token == "" {
			t.Skip("set {{.SandboxEnv}} and " + tokenEnv + " to record")
		}
		report, err := collectortest.Record(collectortest.RecordOptions{
			Spec:    Spec("record", "collectortest"),
			Run:     Run,
			Config:  map[string]any{"organization": organization, "level": "internal"},
			Secrets: map[string]string{tokenEnv: token},
			Out:     "testdata/recordings/{{.Name}}.json",
			Scrub: collectortest.ScrubRules{
				Identifiers: collectortest.EnvIdentifiers("SANDBOX_", map[string]string{"{{.SandboxEnv}}": kitOrganization}),
				Patterns:    recordScrubPatterns,
			},
		})
		if err != nil {
			t.Fatal(err)
		}
		if report.ExitCode != 0 {
			t.Errorf("the recorded run exited %d: %+v", report.ExitCode, report.Failure)
		}
		t.Logf("recorded %d responses", report.Responses)
	})
}
