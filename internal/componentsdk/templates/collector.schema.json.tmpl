{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "{{.BinaryName}}/v1.0.0.json",
  "title": "{{.BinaryName}} output",
  "description": "The artifact {{.BinaryName}} emits at artifacts/{{.Name}}.details.json. The x-epack keywords describe each value. The collector checks its output against this schema when it emits.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "collected_at", "organization"],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "collected_at": {
      "type": "string",
      "format": "date-time"
    },
    "organization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "mfa_required"],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "mfa_required": {
          "type": "boolean",
          "description": "Whether the organization requires every user to enroll an MFA factor.",
          "x-epack-method": "Reads the organization's MFA enrollment setting.",
          "x-epack-label": "MFA required",
          "x-epack-summary": "Whether every user must enroll an MFA factor.",
          "x-epack-goal": true
        }
      }
    },
    "users": {
      "type": "object",
      "description": "The organization's users. Left out, with a gap, when they could not be listed.",
      "additionalProperties": false,
      "required": ["total_count", "mfa_enabled_count", "mfa_enabled_pct"],
      "properties": {
        "total_count": {
          "type": "integer",
          "minimum": 0,
          "x-epack-method": "Counts the users the user list returns, every page included.",
          "x-epack-label": "Users",
          "x-epack-summary": "Users in the organization.",
          "x-epack-rollup": {"rows": "inventory", "as": "count"}
        },
        "mfa_enabled_count": {
          "type": ["integer", "null"],
          "minimum": 0,
          "description": "Users with an active MFA factor. Null, with a partial gap, when some user's factors could not be read.",
          "x-epack-method": "Counts the users whose factor list has at least one active factor.",
          "x-epack-label": "Users with MFA",
          "x-epack-summary": "Users with an active MFA factor.",
          "x-epack-rollup": {"rows": "inventory", "where": "/mfa_enabled", "as": "count"}
        },
        "mfa_enabled_pct": {
          "type": ["integer", "null"],
          "minimum": 0,
          "maximum": 100,
          "description": "Percentage of users with an active MFA factor, rounded down. Null when there are no users, or, with a partial gap, when some user's factors could not be read.",
          "x-epack-method": "Divides mfa_enabled_count by total_count.",
          "x-epack-label": "MFA coverage",
          "x-epack-summary": "Share of users with an active MFA factor.",
          "x-epack-denominator": "total_count",
          "x-epack-numerator": "mfa_enabled_count",
          "x-epack-rounding": "floor",
          "x-epack-rollup": {"rows": "inventory", "where": "/mfa_enabled", "as": "pct"}
        },
        "inventory": {
          "type": "array",
          "description": "Every user.",
          "x-epack-level": "internal",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "name", "mfa_enabled"],
            "properties": {
              "id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "mfa_enabled": {
                "type": ["boolean", "null"],
                "description": "Whether the user has an active MFA factor. Null, with a gap, when the user's factors could not be read.",
                "x-epack-method": "Reads the user's factor list and checks for an active factor.",
                "x-epack-label": "MFA on",
                "x-epack-summary": "Whether the user has an active MFA factor.",
                "x-epack-goal": true
              }
            }
          }
        }
      }
    }
  }
}
