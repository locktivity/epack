// TestCollectorKit runs the collector against the scenarios below and the
// one recorded from the sandbox, then injects faults into each operation's
// calls and checks the output against the schema, every collection level,
// and the credential and sensitivity rules.
func TestCollectorKit(t *testing.T) {
	collectortest.Run(t, collectortest.Suite{
		Spec:    Spec("test", "collectortest"),
		Run:     Run,
		Config:  kitConfig(),
		Secrets: kitSecrets(),
		Scenarios: append([]collectortest.Scenario{
			kitClean(),
			{
				Name: "no users",
				Responses: []collectortest.Response{
					{URL: kitOrg, Body: kitOrgBody},
					{URL: kitOrg + "/users", Body: `[]`},
				},
				Expect: map[string]map[string]any{
					artifactPath: {
						"/users/total_count":       0,
						"/users/mfa_enabled_count": 0,
						"/users/mfa_enabled_pct":   nil,
						"/users/inventory":         []any{},
					},
				},
			},
		}, kitRecordings(t, "{{.Name}}")...),
		// The sign-in is the only call whose failure may fail the run.
		Required: []string{ {{- .VendorPackage}}.OpGetOrganization},
		Semantics: []collectortest.Semantic{
			{
				Operation:     {{.VendorPackage}}.OpGetOrganization,
				Fault:         "404",
				Meaning:       "organization not found",
				ExpectFailure: componentsdk.CodeConfigInvalid,
			},
		},
		Operations: []string{
			{{.VendorPackage}}.OpGetOrganization,
			{{.VendorPackage}}.OpListUsers,
			{{.VendorPackage}}.OpListFactors,
		},
		// Every gap a fault leaves names the faulted call, since the client
		// builds its errors with componentsdk.ResponseError.
		GapOperations: true,
	})
}

// kitRecordings loads the scenarios TestRecord in record_test.go records
// from sandboxes, and logs each one not recorded yet.
func kitRecordings(t *testing.T, names ...string) []collectortest.Scenario {
	t.Helper()
	var out []collectortest.Scenario
	for _, name := range names {
		path := filepath.Join("testdata", "recordings", name+".json")
		sc, err := collectortest.LoadScenario(path)
		switch {
		case errors.Is(err, fs.ErrNotExist):
			t.Logf("no recording at %s yet", path)
		case err != nil:
			t.Fatal(err)
		default:
			out = append(out, sc)
		}
	}
	return out
}

func TestRunRejectsInvalidConfiguration(t *testing.T) {
	cases := map[string]struct {
		config  map[string]any
		secrets map[string]string
	}{
		"no organization":           {map[string]any{"level": "internal"}, kitSecrets()},
		"organization not a string": {map[string]any{"organization": 42}, kitSecrets()},
		"no token":                  {kitConfig(), nil},
	}
	for name, tc := range cases {
		t.Run(name, func(t *testing.T) {
			res := componentsdk.RunInProcess(Spec("test", "collectortest"), Run, componentsdk.InProcessOptions{
				Config:  tc.config,
				Secrets: tc.secrets,
			})
			if res.ExitCode != 2 || res.Failure == nil || res.Failure.Code != componentsdk.CodeConfigInvalid {
				t.Errorf("exit %d, failure %+v; want exit 2 with config_invalid", res.ExitCode, res.Failure)
			}
		})
	}
}

// TestConformanceListsEveryCredential checks that conformance-secrets in
// ci.yaml and CONFORMANCE_SECRETS in the Makefile each list every variable
// the kit passes a credential in. Conformance gives a canary value only to
// the variables they list.
func TestConformanceListsEveryCredential(t *testing.T) {
	want := slices.Sorted(maps.Keys(kitSecrets()))
	for file, key := range map[string]string{
		"../../.github/workflows/ci.yaml": "conformance-secrets:",
		"../../Makefile":                  "CONFORMANCE_SECRETS :=",
	} {
		raw, err := os.ReadFile(filepath.FromSlash(file))
		if err != nil {
			t.Fatal(err)
		}
		var got []string
		for _, line := range strings.Split(string(raw), "\n") {
			if value, ok := strings.CutPrefix(strings.TrimSpace(line), key); ok {
				got = strings.Fields(strings.Trim(value, ` "'`))
				slices.Sort(got)
			}
		}
		if !slices.Equal(got, want) {
			t.Errorf("%s lists %v after %s, want the kit's credentials %v", file, got, key, want)
		}
	}
}
