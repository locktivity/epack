// Package {{.VendorPackage}} calls the vendor's API. TODO: Point Host and baseURL
// at the real API, and replace the calls and types with the ones the
// collector needs.
package {{.VendorPackage}}

import (
	"context"
	"encoding/json"
	"errors"
	"fmt"
	"io"
	"net/http"
	"net/url"

	"github.com/locktivity/epack/componentsdk"
)

// Host is the API's host, the only host the client sends the token to.
const Host = "api.example.com"

const baseURL = "https://" + Host + "/v1"

// Operation names, one per API call. They count each call in the collector
// result and key the test kit's fault matrix and the trace map, so rename
// one only on purpose.
const (
	OpGetOrganization = "{{.Name}}.organization.get"
	OpListUsers       = "{{.Name}}.users.list"
	OpListFactors     = "{{.Name}}.users.factors.list"
)

// PermissionReadUsers is the permission the token needs to list users and
// their factors, in the vendor's own terms, which a permission_denied gap
// names. TODO: Use the vendor's name for it.
const PermissionReadUsers = "users:read"

const (
	maxResponseBytes = 32 << 20
	maxErrorBytes    = 4 << 10
)

// Client reads one organization. Its calls go through the client
// componentsdk.NewHTTPClient returns, which retries the calls it can.
type Client struct {
	http         *http.Client
	organization string
	token        string
}

// NewClient returns a client that reads organization with token.
func NewClient(httpClient *http.Client, organization, token string) *Client {
	return &Client{http: httpClient, organization: organization, token: token}
}

// Organization is the organization the client reads.
type Organization struct {
	ID          string `json:"id"`
	Name        string `json:"name"`
	MFARequired *bool  `json:"mfa_required"`
}

// User is a member of the organization.
type User struct {
	ID   string `json:"id"`
	Name string `json:"name"`
}

// Factor is an MFA factor a user enrolled.
type Factor struct {
	ID     string `json:"id"`
	Type   string `json:"type"`
	Status string `json:"status"`
}

// GetOrganization reads the organization. It is the collector's sign-in: it
// proves the token works and can read the organization. A 404 means there is
// no organization by that name, which is a configuration error.
func (c *Client) GetOrganization(ctx context.Context) (*Organization, error) {
	var org Organization
	resp, err := c.get(ctx, OpGetOrganization, "/organizations/"+url.PathEscape(c.organization), &org)
	var apiErr *APIError
	if errors.As(err, &apiErr) && apiErr.StatusCode == http.StatusNotFound {
		return nil, componentsdk.CodeError(componentsdk.CodeConfigInvalid, fmt.Errorf("organization %q not found: %w", c.organization, err))
	}
	if err != nil {
		return nil, err
	}
	if org.ID == "" || org.MFARequired == nil {
		return nil, componentsdk.ResponseError(resp, invalidResponse(OpGetOrganization, "has no id or mfa_required"))
	}
	return &org, nil
}

// ListUsers lists the organization's users.
func (c *Client) ListUsers(ctx context.Context) ([]User, error) {
	return list[User](ctx, c, OpListUsers, "/organizations/"+url.PathEscape(c.organization)+"/users")
}

// ListFactors lists the MFA factors a user enrolled.
func (c *Client) ListFactors(ctx context.Context, userID string) ([]Factor, error) {
	return list[Factor](ctx, c, OpListFactors, "/users/"+url.PathEscape(userID)+"/factors")
}

// list reads a JSON array. A null in its place is a malformed response, so
// it never reads as an empty list.
func list[T any](ctx context.Context, c *Client, op, path string) ([]T, error) {
	var items []T
	resp, err := c.get(ctx, op, path, &items)
	if err != nil {
		return nil, err
	}
	if items == nil {
		return nil, componentsdk.ResponseError(resp, invalidResponse(op, "is null, not a list"))
	}
	return items, nil
}

// get sends a GET named op and decodes the JSON response into out. It
// returns the response, its body read and closed, so a caller that finds the
// body wanting can build an error with componentsdk.ResponseError, which
// gives a gap recorded from it the response's call.
func (c *Client) get(ctx context.Context, op, path string, out any) (*http.Response, error) {
	ctx = componentsdk.WithOperation(ctx, componentsdk.Operation{Name: op})
	req, err := http.NewRequestWithContext(ctx, http.MethodGet, baseURL+path, nil)
	if err != nil {
		return nil, err
	}
	req.Header.Set("Authorization", "Bearer "+c.token)
	req.Header.Set("Accept", "application/json")

	resp, err := c.http.Do(req)
	if err != nil {
		return nil, err
	}
	defer func() { _ = resp.Body.Close() }()

	if resp.StatusCode != http.StatusOK {
		body, _ := io.ReadAll(io.LimitReader(resp.Body, maxErrorBytes))
		return resp, componentsdk.ResponseError(resp, &APIError{StatusCode: resp.StatusCode, Body: string(body), Header: resp.Header})
	}
	if err := json.NewDecoder(io.LimitReader(resp.Body, maxResponseBytes)).Decode(out); err != nil {
		return resp, componentsdk.ResponseError(resp, fmt.Errorf("%s: decoding the response: %w", op, err))
	}
	return resp, nil
}

// VendorCode reads the vendor's own error code from a failed response's
// body, for componentsdk.HTTPOptions.VendorCode, which records it on the
// response's row in the collector result. It returns the code alone, never
// the message, which can name a resource. TODO: Read the vendor's error
// format; this one reads {"error": {"code": "..."}}.
func VendorCode(_ *http.Response, body []byte) string {
	var e struct {
		Error struct {
			Code string `json:"code"`
		} `json:"error"`
	}
	if json.Unmarshal(body, &e) != nil {
		return ""
	}
	return e.Error.Code
}

// APIError is a response whose status is not 200.
type APIError struct {
	StatusCode int
	Body       string
	Header     http.Header
}

func (e *APIError) Error() string {
	return fmt.Sprintf("API returned status %d: %s", e.StatusCode, e.Body)
}

// HTTPStatus and HTTPHeader let componentsdk.Classify give the error its
// code, such as permission_denied for a 403 or rate_limited for a 429.
func (e *APIError) HTTPStatus() int         { return e.StatusCode }
func (e *APIError) HTTPHeader() http.Header { return e.Header }

func invalidResponse(op, problem string) error {
	return componentsdk.CodeError(componentsdk.CodeInvalidResponse, fmt.Errorf("%s: the response %s", op, problem))
}
