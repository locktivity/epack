.PHONY: build build-all check test checks lint govulncheck clean conformance

BINARY_NAME := {{.BinaryName}}
MAIN := {{.MainPackage}}
VERSION := $(shell git describe --tags --always --dirty 2>/dev/null || echo "dev")
LDFLAGS := -X 'main.Version=$(VERSION)'
# Every target runs as CI does: against the epack version go.mod pins, not a
# go.work that points at a local checkout, and under go.mod's toolchain line,
# the Go release CI installs. golangci-lint refuses a module whose Go version
# is newer than the one it was built with. Set either variable in the
# environment to override, such as GOWORK=../go.work make test.
export GOWORK ?= off
GO_TOOLCHAIN := $(shell sed -n 's/^toolchain \([^[:space:]]*\).*/\1/p' go.mod)
export GOTOOLCHAIN ?= $(GO_TOOLCHAIN)
EPACK_VERSION = $(shell GOWORK=off go list -m -f '{{"{{"}}.Version{{"}}"}}' github.com/locktivity/epack)

# Everything CI checks, from a fresh clone, fastest failures first.
check: lint checks test govulncheck conformance

build:
	go build -ldflags "$(LDFLAGS)" -o $(BINARY_NAME) $(MAIN)

build-all:
	CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -trimpath -ldflags "$(LDFLAGS)" -o $(BINARY_NAME)-linux-amd64 $(MAIN)
	CGO_ENABLED=0 GOOS=linux GOARCH=arm64 go build -trimpath -ldflags "$(LDFLAGS)" -o $(BINARY_NAME)-linux-arm64 $(MAIN)
	CGO_ENABLED=0 GOOS=darwin GOARCH=amd64 go build -trimpath -ldflags "$(LDFLAGS)" -o $(BINARY_NAME)-darwin-amd64 $(MAIN)
	CGO_ENABLED=0 GOOS=darwin GOARCH=arm64 go build -trimpath -ldflags "$(LDFLAGS)" -o $(BINARY_NAME)-darwin-arm64 $(MAIN)

# A suite that runs past Go's default under the race detector raises this.
TEST_TIMEOUT ?= 10m
test:
	go test -race -v -timeout $(TEST_TIMEOUT) ./...

# The repository's own checks, run after lint.
CHECKS := $(wildcard scripts/check-*.sh)
checks:
	@for check in $(CHECKS); do echo "$$check"; bash -euo pipefail "$$check" || exit 1; done

# The golangci-lint version CI runs, built by go run under the toolchain
# above, so there is no install script and no binary to keep current.
GOLANGCI_LINT_VERSION := v2.15.0
GOLANGCI_LINT := go run github.com/golangci/golangci-lint/v2/cmd/golangci-lint@$(GOLANGCI_LINT_VERSION)
lint:
	$(GOLANGCI_LINT) run ./...

# The govulncheck version CI runs.
GOVULNCHECK_VERSION := v1.8.0
govulncheck:
	go run golang.org/x/vuln/cmd/govulncheck@$(GOVULNCHECK_VERSION) ./...

clean:
	rm -f $(BINARY_NAME) $(BINARY_NAME)-*

# Conformance at the epack version go.mod pins, as CI runs it.
conformance: build
	go run -tags conformance github.com/locktivity/epack/cmd/epack-conformance@$(EPACK_VERSION) {{.Kind}} ./$(BINARY_NAME) --level standard
