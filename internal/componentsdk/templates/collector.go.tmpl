package collector

import (
	"fmt"
	"time"

	"github.com/locktivity/epack/componentsdk"

	"{{.ModulePath}}/internal/{{.VendorPackage}}"
)

// SchemaVersion is the version of docs/schema/v1.0.0.json, which describes
// Output. It stays 1.0.0 until the collector itself reaches v1.0.0.
const SchemaVersion = "1.0.0"

// Output is the artifact the collector emits at artifactPath.
type Output struct {
	SchemaVersion    string       `json:"schema_version"`
	CollectedAt      string       `json:"collected_at"`
	CollectedAtLevel string       `json:"collected_at_level"`
	Organization     Organization `json:"organization"`
	// Users is left out, with a gap, when the users could not be listed.
	Users *Users `json:"users,omitempty"`
}

// Organization describes the organization the collector signed in to.
type Organization struct {
	ID          string `json:"id"`
	Name        string `json:"name"`
	MFARequired bool   `json:"mfa_required"`
}

// Users rolls up the organization's users.
type Users struct {
	TotalCount int `json:"total_count"`
	// MFAEnabledCount and MFAEnabledPct are null, with a partial gap, when
	// some user's factors could not be read. MFAEnabledPct, rounded down so
	// that 100 means every user, is also null when there are no users.
	MFAEnabledCount *int `json:"mfa_enabled_count"`
	MFAEnabledPct   *int `json:"mfa_enabled_pct"`
	// Inventory lists every user at the internal level.
	Inventory []User `json:"inventory,omitzero"`
}

// User is one row of the inventory.
type User struct {
	ID   string `json:"id"`
	Name string `json:"name"`
	// MFAEnabled is null, with a gap, when the user's factors could not be
	// read.
	MFAEnabled *bool `json:"mfa_enabled"`
}

// collect signs in and reads the organization's users, each part in a step
// of its own, which the collector result lists with its calls. It fails only
// when the sign-in fails. A value it cannot read after that is left out of
// the output with a gap, never written as zero or false.
func collect(ctx componentsdk.CollectorContext, client *{{.VendorPackage}}.Client) (*Output, error) {
	signIn, step := componentsdk.StartCollectorStep(ctx, "sign_in", "Signing in")
	org, err := client.GetOrganization(signIn.Context())
	step.End()
	if err != nil {
		return nil, fmt.Errorf("signing in: %w", err)
	}
	rec := componentsdk.Records(ctx)
	rec.SignedInAs(componentsdk.Principal{Provider: "{{.Name}}", Kind: "api_token", TenantID: org.ID, AuthMethod: componentsdk.AuthAPIToken})

	out := &Output{
		SchemaVersion:    SchemaVersion,
		CollectedAt:      componentsdk.Now(ctx).UTC().Format(time.RFC3339),
		CollectedAtLevel: string(ctx.Level()),
		Organization:     Organization{ID: org.ID, Name: org.Name, MFARequired: *org.MFARequired},
	}
	gaps := gapLog{rec: rec}

	people, step := componentsdk.StartCollectorStep(ctx, "users", "Reading users and their MFA factors")
	defer step.End()
	users, err := client.ListUsers(people.Context())
	if err != nil {
		gaps.notCollected(err, "/users", componentsdk.MissingPermission({{.VendorPackage}}.PermissionReadUsers))
		return out, nil
	}
	out.Users = readUsers(people, client, gaps, users)
	return out, nil
}

// readUsers reads each user's factors in the step ctx carries. A user whose
// factors cannot be read has mfa_enabled left out, and so do the rollups
// over every user.
func readUsers(ctx componentsdk.CollectorContext, client *{{.VendorPackage}}.Client, gaps gapLog, users []{{.VendorPackage}}.User) *Users {
	inventory := ctx.Level().AtLeast(componentsdk.LevelInternal)
	rows := make([]User, len(users))
	enabled, unmeasured := 0, 0
	var firstErr error
	for i, u := range users {
		ctx.Progress(int64(i+1), int64(len(users)), "Reading MFA factors")
		rows[i] = User{ID: u.ID, Name: u.Name}
		factors, err := client.ListFactors(ctx.Context(), u.ID)
		if err != nil {
			unmeasured++
			if firstErr == nil {
				firstErr = err
			}
			if inventory {
				gaps.notCollected(err, rowPointer("/users/inventory", i, "mfa_enabled"))
			}
			continue
		}
		on := hasActiveFactor(factors)
		rows[i].MFAEnabled = &on
		if on {
			enabled++
		}
	}

	out := &Users{TotalCount: len(users)}
	if unmeasured > 0 {
		gaps.partial(unmeasured, firstErr, "/users/mfa_enabled_count", "/users/mfa_enabled_pct")
	} else {
		out.MFAEnabledCount = &enabled
		out.MFAEnabledPct = percent(enabled, len(users))
	}
	if inventory {
		out.Inventory = rows
	}
	return out
}

func hasActiveFactor(factors []{{.VendorPackage}}.Factor) bool {
	for _, f := range factors {
		if f.Status == "active" {
			return true
		}
	}
	return false
}

// percent is n of total as a whole percentage rounded down, so that 100
// means all of them, or nil when total is 0. The schema says so with
// x-epack-rounding, and the output checks hold the value to it.
func percent(n, total int) *int {
	if total == 0 {
		return nil
	}
	p := n * 100 / total
	return &p
}
